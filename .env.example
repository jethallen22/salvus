# Supabase project → Connect dialog. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL written onto the NFC tag. Use your deployed https:// URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. 32 random bytes, base64: openssl rand -base64 32
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
TOKEN_ENC_KEY=

# Server-only. Supabase → Settings → API Keys → secret key (sb_secret_...). Used only by the
# server to create, update, deactivate and delete users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
